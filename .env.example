# Copy to .env and fill in. Never commit .env.

POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=

# Admin API key Atlas sends as X-API-Key. Empty disables the admin API.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# Fernet key encrypting NAS shared secrets at rest.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NAS_SECRET_KEY=
# Address Atlas dials for the admin API (Caddy, tls internal).
ENGINE_API_SITE=https://10.140.140.20:8443

TIMEZONE=Asia/Beirut
DAILY_RESET_TIME=00:00

# Actuation (CoA / Disconnect). Starts in dry-run: plans are written to the
# audit log, nothing is sent. Flip to false after reviewing a day of plans.
ACTUATION_DRY_RUN=true
ACTUATION_MAX_PER_MINUTE=120
# JSON list. Add "Mikrotik-Address-List" only after a test account proves
# your ROS builds apply it mid-session.
COA_MUTABLE_ATTRIBUTES=["Mikrotik-Rate-Limit","Session-Timeout"]

# closed = deny when the backend can't decide in time; open = allow at
# AUTHZ_FAIL_OPEN_DEFAULT_RATE_BPS.
AUTHZ_FAIL_MODE=closed

WALLED_GARDEN_ADDRESS_LIST=walled-garden
SESSION_STALE_AFTER_S=900
